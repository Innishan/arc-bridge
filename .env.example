# Production is the default and uses Circle App Kit's keyless CCTP bridge path.
VITE_ARCBRIDGE_ENV=mainnet

# Public analytics API origin only; never put backend credentials in Vite variables.
VITE_ARCBRIDGE_API_URL=https://arc-bridge-backend.onrender.com

# Optional public production developer-fee configuration. These are disabled
# unless BOTH the recipient and a non-zero operation percentage are set.
# The recipient is public; never put a private key or Circle API key in Vite.
VITE_ARCBRIDGE_FEE_RECIPIENT=0x3fa6CD6A58D9A3F2f0159f1BCA3b5f6cB9b9a7c9
VITE_ARCBRIDGE_PRODUCTION_BRIDGE_FEE_BPS=25
VITE_ARCBRIDGE_PRODUCTION_SWAP_FEE_BPS=0

# Set only in a separate test deployment to use the legacy Arc Testnet bridge.
# VITE_ARCBRIDGE_ENV=testnet
